import { Card, Chip } from "types.slint";
import { FolderBody } from "bodies_folder.slint";
import { PapersBody } from "bodies_papers.slint";
import { Theme, Hue } from "theme.slint";
import { Words } from "words.slint";

export { Hue }

export component Icon inherits Image {
    in property <color> tint: Theme.muted;
    width: 15px;
    height: 15px;
    colorize: tint;
}

component Unpictured inherits Icon {
    source: @image-url("../assets/icons/image.svg");
    tint: Theme.field-border;
    width: 18px;
    height: 18px;
}

export component Action inherits Rectangle {
    in property <string> says;
    accessible-role: AccessibleRole.button;
    accessible-label: says;
    in property <image> icon;
    in property <color> hot: Theme.body;
    in property <bool> awake: true;
    in property <bool> marked;
    callback pressed();
    width: 22px;
    height: 22px;
    border-radius: Theme.radius-inset;
    background: touch.has-hover ? Theme.hover : root.marked ? Theme.tile : transparent;
    animate background { duration: 100ms; }
    Icon { source: root.icon; width: 14px; height: 14px; tint: touch.has-hover ? root.hot : root.marked ? Theme.accent-dim : Theme.muted; }
    touch := TouchArea {
        enabled: root.awake;
        clicked => { root.pressed(); }
    }
}

export component KindIcon inherits Icon {
    in property <string> kind;
    width: 13px;
    height: 13px;
    source: kind == "image" ? @image-url("../assets/icons/image.svg")
        : kind == "json" ? @image-url("../assets/icons/braces.svg")
        : kind == "code" ? @image-url("../assets/icons/code.svg")
        : kind == "link" ? @image-url("../assets/icons/link.svg")
        : kind == "email" ? @image-url("../assets/icons/mail.svg")
        : kind == "phone" ? @image-url("../assets/icons/phone.svg")
        : kind == "color" ? @image-url("../assets/icons/palette.svg")
        : kind == "ip" || kind == "uuid" ? @image-url("../assets/icons/hash.svg")
        : kind == "token" ? @image-url("../assets/icons/key-round.svg")
        : kind == "folder" ? @image-url("../assets/icons/folder.svg")
        : kind == "audio" ? @image-url("../assets/icons/music.svg")
        : kind == "video" ? @image-url("../assets/icons/video.svg")
        : kind == "file" ? @image-url("../assets/icons/file.svg")
        : @image-url("../assets/icons/file-text.svg");
}

export component Pill inherits Rectangle {
    in property <Chip> chip;
    accessible-role: AccessibleRole.button;
    accessible-label: chip.label;
    callback chosen(string, bool);
    height: 24px;
    width: content.preferred-width;
    border-radius: 12px;
    background: chip.selected ? Theme.selected : touch.has-hover ? Theme.hover : Theme.field;
    border-width: 1px;
    border-color: chip.selected ? Theme.selected-edge : Theme.field-border;
    animate background { duration: 120ms; easing: ease-out; }
    animate border-color { duration: 120ms; easing: ease-out; }
    content := HorizontalLayout {
        padding-left: 9px;
        padding-right: 9px;
        spacing: 5px;
        alignment: center;
        Rectangle {
            width: 7px;
            height: 7px;
            border-radius: 2px;
            background: Hue.of(chip.key);
            y: (parent.height - 7px) / 2;
        }
        Text { text: chip.label; color: chip.selected ? Theme.accent : Theme.title; font-size: Theme.fs-meta; font-weight: chip.selected ? 600 : 500; vertical-alignment: center; }
        if chip.count != "" : Text { text: chip.count; color: chip.selected ? Theme.accent-dim : Theme.muted; font-size: Theme.fs-caption; vertical-alignment: center; }
    }
    touch := TouchArea {
        property <bool> adding;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                self.adding = event.modifiers.control;
            }
        }
        clicked => { root.chosen(chip.key, touch.adding); }
    }

}

export component Tag inherits Rectangle {
    in property <Chip> tag;
    callback dropped(string);
    height: 20px;
    width: row.preferred-width;
    border-radius: Theme.radius-inset;
    background: Theme.selected;
    border-width: 1px;
    border-color: Theme.selected-edge;
    row := HorizontalLayout {
        padding-left: 7px;
        padding-right: 4px;
        spacing: 4px;
        alignment: center;
        Rectangle {
            width: 6px;
            height: 6px;
            border-radius: 2px;
            background: Hue.of(tag.key);
            y: (parent.height - 6px) / 2;
        }
        Text { text: tag.label; color: Theme.accent; font-size: Theme.fs-meta; font-weight: 600; vertical-alignment: center; }
        Rectangle {
            width: 14px;
            height: 14px;
            border-radius: 7px;
            y: (parent.height - 14px) / 2;
            background: close.has-hover ? Theme.pressed : transparent;
            Image {
                source: @image-url("../assets/icons/x.svg");
                width: 9px;
                height: 9px;
                colorize: close.has-hover ? Theme.body : Theme.accent-dim;
            }
            close := TouchArea {
                clicked => { root.dropped(tag.key); }
            }
        }
    }
}

component NameField inherits Rectangle {
    in property <string> seed;
    in property <length> words-size: Theme.fs-small;
    property <bool> settled;
    callback done(string);
    callback gave-up();
    border-radius: 5px;
    background: Theme.tile;
    border-width: 1px;
    border-color: Theme.accent;
    in property <int> room;
    if root.room > 0 && field.text.character-count > root.room - 12 : Text {
        x: parent.width - self.width - 6px;
        y: (parent.height - self.height) / 2;
        text: root.room - field.text.character-count;
        color: field.text.character-count > root.room ? Theme.danger : Theme.muted;
        font-size: Theme.fs-caption;
    }
    field := TextInput {
        accessible-role: AccessibleRole.text-input;
        accessible-label: Words.name-it;
        x: 6px;
        width: parent.width - 34px;
        height: parent.height;
        text: root.seed;
        color: Theme.body;
        selection-background-color: Theme.accent;
        selection-foreground-color: Theme.panel;
        font-size: root.words-size;
        single-line: true;
        vertical-alignment: center;
        init => {
            self.focus();
            self.select-all();
        }
        accepted => {
            root.settled = true;
            root.done(self.text);
        }
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.settled = true;
                root.gave-up();
                return accept;
            }
            return reject;
        }
        changed has-focus => {
            if (!self.has-focus && !root.settled) {
                root.settled = true;
                root.done(self.text);
            }
        }
    }
}

component KeyChip inherits Rectangle {
    in property <string> keys;
    in property <string> says;
    in property <bool> on;
    callback pressed();
    accessible-role: AccessibleRole.button;
    accessible-label: root.says;
    height: 22px;
    width: chip-row.preferred-width;
    border-radius: Theme.radius-inset;
    background: touch.has-hover ? Theme.hover : on ? Theme.selected : Theme.field;
    animate background { duration: 100ms; }
    border-width: 1px;
    border-color: on || touch.has-hover ? Theme.selected-edge : Theme.field-border;
    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.pressed(); }
    }
    chip-row := HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 5px;
        Text { text: root.keys; color: root.on ? Theme.accent : Theme.muted; font-size: Theme.fs-meta; font-weight: 600; vertical-alignment: center; }
        Text { text: root.says; color: root.on ? Theme.accent : Theme.title; font-size: Theme.fs-meta; vertical-alignment: center; }
    }
}

export component CardView inherits Rectangle {
    in property <Card> card;
    in property <string> layout;
    in property <bool> one-kind;
    in property <bool> current;
    in property <int> naming: -1;
    property <bool> being-named: root.naming == card.id;
    in property <bool> open;
    in property <bool> shown-here;
    in property <bool> quiet;
    callback copy(int);
    callback open-asked(int);
    callback paste(int);
    callback plain(int);
    callback edit(int);
    callback named(int, string);
    callback naming-dropped();
    callback pin(int, bool);
    callback remove(int);
    callback chosen(int, length, length);
    callback stirred(length, length);
    callback dragged(int);
    property <bool> dragging;
    property <bool> lit: shown-here;
    property <bool> hovering: touch.has-hover && !quiet;
    accessible-role: AccessibleRole.list-item;
    accessible-label: (card.name != "" ? card.name + ", " : "") + card.title + ", " + card.body;
    border-radius: Theme.radius-card;
    border-width: 1px;
    border-color: Theme.card-edge;
    background: lit ? Theme.selected : hovering ? Theme.row-hover : Theme.card;
    animate background, border-color { duration: lit || hovering ? 0ms : Theme.let-go; easing: ease-out; }
    touch := TouchArea {
        clicked => {
            if (!root.dragging) {
                root.chosen(card.id, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.dragging = false;
            }
            if (event.kind == PointerEventKind.move) {
                root.stirred(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                if (touch.pressed && !root.dragging && card.can-drag
                    && (abs(touch.mouse-x - touch.pressed-x) > Theme.drag-start
                        || abs(touch.mouse-y - touch.pressed-y) > Theme.drag-start)) {
                    root.dragging = true;
                    root.dragged(card.id);
                }
            }
        }
    }

    if lit : Rectangle {
        x: 0px;
        y: 8px;
        width: 3px;
        height: parent.height - 16px;
        border-radius: 1.5px;
        background: Theme.accent;
    }

    VerticalLayout {
        padding: 10px;
        padding-top: 9px;
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;

        VerticalLayout {
            spacing: 6px;

            HorizontalLayout {
                height: 22px;
                spacing: 5px;
                if being-named : NameField {
                    seed: card.name;
                    room: Words.name-room;
                    words-size: Theme.fs-small;
                    width: 200px;
                    done(said) => { root.named(card.id, said); }
                    gave-up => { root.naming-dropped(); }
                }
                if !being-named && card.name != "" : Text {
                    text: card.name;
                    color: Theme.body;
                    font-size: Theme.fs-small;
                    font-weight: Theme.fw-title;
                    overflow: elide;
                    wrap: no-wrap;
                    max-width: 180px;
                    vertical-alignment: center;
                }
                if card.face == "paint" : Rectangle {
                    width: 18px;
                    height: 18px;
                    y: (parent.height - 18px) / 2;
                    border-radius: 5px;
                    background: card.paint;
                    border-width: 1px;
                    border-color: Theme.selected-edge;
                }
                if card.face == "paint" : Text {
                    text: card.squeezed;
                    color: Theme.body;
                    font-size: Theme.fs-body;
                    font-family: Theme.mono-font;
                    overflow: elide;
                    wrap: no-wrap;
                    vertical-alignment: center;
                }
                if !one-kind && card.face != "paint" : Text {
                    text: card.title;
                    color: Hue.of(card.kind);
                    font-size: Theme.fs-meta;
                    font-weight: Theme.fw-title;
                    vertical-alignment: center;
                }
                if card.aside-said != "" : Text {
                    text: (one-kind ? "" : "· ") + card.aside-said;
                    color: Theme.muted;
                    font-size: Theme.fs-meta;
                    overflow: elide;
                    wrap: no-wrap;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                if card.aside-said == "" : Rectangle { horizontal-stretch: 1; }
                if card.alert != "" : Rectangle {
                    width: alert-pill.preferred-width;
                    height: 15px;
                    border-radius: Theme.radius-badge;
                    background: Theme.alert-back;
                    y: (parent.height - 15px) / 2;
                    alert-pill := HorizontalLayout {
                        padding-left: 5px;
                        padding-right: 5px;
                        Text { text: card.alert; color: Theme.alert-ink; font-size: Theme.fs-caption; font-weight: 600; vertical-alignment: center; }
                    }
                }
                if card.pinned && !lit && !open : Icon {
                    source: @image-url("../assets/icons/pin.svg");
                    width: 10px;
                    height: 10px;
                    tint: Theme.accent-dim;
                    y: (parent.height - 10px) / 2;
                }
                if !lit && !open : Text {
                    text: card.age;
                    color: Theme.muted;
                    font-size: Theme.fs-meta;
                    vertical-alignment: center;
                }
                if lit || open : HorizontalLayout {
                    spacing: 2px;
                    alignment: center;
                    if card.can-open && !card.broken : Action { icon: @image-url("../assets/icons/external-link.svg"); says: Words.open-it; pressed => { root.open-asked(card.id); } }
                    Action { icon: @image-url("../assets/icons/pencil.svg"); says: Words.name-it; pressed => { root.edit(card.id); } }
                    if !card.broken : Action { icon: @image-url("../assets/icons/copy.svg"); says: Words.copy-it; pressed => { root.copy(card.id); } }
                    Action { icon: card.pinned ? @image-url("../assets/icons/pin-off.svg") : @image-url("../assets/icons/pin.svg"); says: card.pinned ? Words.unpin : Words.pin; pressed => { root.pin(card.id, !card.pinned); } }
                    Action { icon: @image-url("../assets/icons/trash-2.svg"); says: Words.remove; hot: Theme.danger; pressed => { root.remove(card.id); } }
                }
            }

            if !open && card.face == "found" : HorizontalLayout {
                height: 19px;
                Text { text: card.lead; color: Theme.muted; font-size: Theme.fs-body; vertical-alignment: center; }
                Text { text: card.hit; color: Theme.accent; font-size: Theme.fs-body; font-weight: 600; vertical-alignment: center; }
                Text { text: card.tail; color: Theme.body; font-size: Theme.fs-body; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
            }

            if !open && card.face == "thumb" : HorizontalLayout {
                height: 50px;
                spacing: 12px;
                Rectangle {
                    width: 88px;
                    height: 50px;
                    border-radius: 7px;
                    clip: true;
                    background: Theme.tile;
                    Image { source: card.thumb; width: parent.width; height: parent.height; image-fit: cover; }
                    if !card.has-thumb : Unpictured { }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    Text { text: card.headline; color: Theme.body; font-size: Theme.fs-body; overflow: elide; wrap: no-wrap; }
                    if card.media-measures != "" && card.media-measures != card.headline : Text {
                        text: card.media-measures;
                        color: Theme.muted;
                        font-size: Theme.fs-meta;
                        overflow: elide;
                        wrap: no-wrap;
                    }
                }
            }

            if !open && card.face == "found-thumb" : HorizontalLayout {
                height: 50px;
                spacing: 12px;
                Rectangle {
                    width: 50px;
                    height: 50px;
                    border-radius: 7px;
                    clip: true;
                    background: Theme.tile;
                    Image { source: card.thumb; width: parent.width; height: parent.height; image-fit: cover; }
                    if !card.has-thumb : Unpictured { }
                }
                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        height: 19px;
                        Text { text: card.lead; color: Theme.muted; font-size: Theme.fs-body; vertical-alignment: center; }
                        Text { text: card.hit; color: Theme.accent; font-size: Theme.fs-body; font-weight: 600; vertical-alignment: center; }
                        Text { text: card.tail; color: Theme.body; font-size: Theme.fs-body; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                    }
                }
            }

            if !open && card.face == "block" : Rectangle {
                height: 12px + card.shut-lines * 17px;
                border-radius: Theme.radius-inset;
                background: Theme.tile;
                VerticalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    padding-top: 6px;
                    padding-bottom: 6px;
                    Text { text: card.line-one; height: 17px; color: Theme.mono; font-size: Theme.fs-small; font-family: Theme.mono-font; overflow: elide; wrap: no-wrap; vertical-alignment: center; }
                    if card.shut-lines > 1 : Text { text: card.line-two; height: 17px; color: Theme.mono; font-size: Theme.fs-small; font-family: Theme.mono-font; overflow: elide; wrap: no-wrap; vertical-alignment: center; }
                }
            }

            if !open && card.face == "link" : HorizontalLayout {
                height: 19px;
                Text { text: card.link-domain; color: Theme.body; font-size: Theme.fs-body; font-weight: 600; wrap: no-wrap; vertical-alignment: center; }
                Text { text: card.link-path; color: Theme.muted; font-size: Theme.fs-body; overflow: elide; wrap: no-wrap; horizontal-stretch: 1; vertical-alignment: center; }
            }

            if !open && card.face == "file" : HorizontalLayout {
                height: 34px;
                spacing: 10px;
                Rectangle {
                    width: 34px;
                    height: 34px;
                    border-radius: 7px;
                    background: Theme.tile;
                    if card.papers-format != "" : Text {
                        text: card.papers-format;
                        color: Hue.of(card.kind);
                        font-size: Theme.fs-caption;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    if card.papers-format == "" : KindIcon {
                        kind: card.kind;
                        width: 16px;
                        height: 16px;
                        tint: Hue.of(card.kind);
                    }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 1px;
                    Text {
                        text: card.folder-name != "" ? card.folder-name : card.headline;
                        color: card.broken ? Theme.danger : Theme.body;
                        font-size: Theme.fs-body;
                        overflow: elide;
                        wrap: no-wrap;
                    }
                    if card.folder-parent != "" || card.media-measures != "" : Text {
                        text: card.folder-parent != "" ? card.folder-parent : card.media-measures;
                        color: Theme.muted;
                        font-size: Theme.fs-meta;
                        overflow: elide;
                        wrap: no-wrap;
                    }
                }
            }

            if !open && card.face == "words" : Text {
                text: card.squeezed;
                height: card.shut-lines * 19px;
                color: card.broken ? Theme.danger : card.blank ? Theme.muted : Theme.body;
                font-size: Theme.fs-body;
                wrap: word-wrap;
                overflow: elide;
            }

            if open && (card.face == "thumb" || card.face == "found-thumb") : Rectangle {
                height: 146px;
                border-radius: 8px;
                clip: true;
                background: Theme.tile;
                Image { source: card.thumb; width: parent.width; height: parent.height; image-fit: contain; }
                if !card.has-thumb : Unpictured { width: 26px; height: 26px; }
            }
            if open && (card.face == "thumb" || card.face == "found-thumb") : Text {
                height: 15px;
                text: card.media-measures != "" ? card.media-measures : card.headline;
                color: Theme.muted;
                font-size: Theme.fs-meta;
                overflow: elide;
                wrap: no-wrap;
            }

            if open && (card.face == "words" || card.face == "found") : Text {
                text: card.opened;
                height: card.open-lines * 19px;
                color: card.broken ? Theme.danger : card.blank ? Theme.muted : Theme.body;
                font-size: Theme.fs-body;
                wrap: word-wrap;
                overflow: elide;
            }

            if open && (card.face == "block" || card.face == "link") : Rectangle {
                height: 12px + card.open-lines * 17px;
                border-radius: Theme.radius-inset;
                background: Theme.tile;
                Text {
                    x: 8px;
                    y: 6px;
                    width: parent.width - 16px;
                    height: parent.height - 12px;
                    text: card.opened;
                    color: Theme.mono;
                    font-size: Theme.fs-small;
                    font-family: Theme.mono-font;
                    wrap: card.face == "link" ? char-wrap : no-wrap;
                    overflow: elide;
                }
            }

            if open && card.more-said != "" : Text {
                height: 15px;
                text: card.more-said;
                color: Theme.muted;
                font-size: Theme.fs-meta;
            }

            if open && card.face == "paint" : HorizontalLayout {
                height: 48px;
                spacing: 12px;
                Rectangle {
                    width: 48px;
                    height: 48px;
                    border-radius: 9px;
                    background: card.paint;
                    border-width: 1px;
                    border-color: Theme.selected-edge;
                }
                Text {
                    text: card.paint-said;
                    color: Theme.muted;
                    font-size: Theme.fs-body;
                    font-family: Theme.mono-font;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
            }

            if open && card.face == "file" && card.kind == "folder" : FolderBody { card: card; }
            if open && card.face == "file" && card.kind != "folder" : PapersBody { card: card; }

            if open && !card.broken : HorizontalLayout {
                height: 22px;
                spacing: 6px;
                KeyChip { keys: "⏎"; says: Words.paste-it; on: true; pressed => { root.paste(card.id); } }
                KeyChip { keys: "⇧⏎"; says: Words.paste-plain; pressed => { root.plain(card.id); } }
                Rectangle { horizontal-stretch: 1; }
            }
        }

    }
}
