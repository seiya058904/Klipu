export global Theme {
    in-out property <bool> light: false;
    in-out property <string> font: "Segoe UI";
    in-out property <string> mono-font: "Consolas";
    in-out property <float> zoom: 1;
    in-out property <color> panel: light ? #F6F6F8 : #16171B;
    out property <color> panel-border: light ? #DFE0E6 : #2A2B31;
    out property <color> footer: light ? #EFEFF3 : #131418;
    out property <color> card: light ? #FFFFFF : #1F2025;
    out property <color> card-edge: transparent;
    out property <color> row-hover: light ? #F1F1F5 : #26272D;
    out property <color> field: light ? #FFFFFF : #1C1D22;
    out property <color> field-border: light ? #D6D7DE : #2F3037;
    out property <color> tile: light ? #F0F0F4 : #2A2B31;
    out property <color> hover: light ? #1418301A : #303138;
    out property <color> pressed: light ? #14183026 : #383A42;
    in-out property <color> grip: light ? #B4B1EC : #4A5085;
    out property <color> grip-hover: light ? #6A6B75 : #6B6E78;
    out property <color> body: light ? #24252B : #E4E5E9;
    out property <color> title: light ? #3A3B43 : #C6C7CD;
    out property <color> mono: light ? #2E2F36 : #CFD1D6;
    out property <color> muted: light ? #676873 : #8F919B;
    out property <color> placeholder: light ? #8A8B95 : #6E7079;
    in-out property <color> accent: light ? #4F46E5 : #A5B4FC;
    in-out property <color> accent-dim: light ? #6B63EA : #7C86C9;
    in-out property <color> focus: light ? #6B63EA : #7C86C9;
    in-out property <color> selected: light ? #E9E9FB : #282C46;
    in-out property <color> selected-edge: light ? #B4B1EC : #4A5085;
    out property <color> danger: light ? #C0392B : #F28B82;
    out property <color> alert-back: light ? #FDE9B5 : #46351C;
    out property <color> alert-ink: light ? #7A4E07 : #FCD34D;
    out property <color> scrim: #000000A6;
    out property <length> radius: 8px;
    out property <length> radius-card: 10px;
    out property <length> radius-control: 8px;
    out property <length> radius-inset: 6px;
    out property <length> radius-badge: 4px;
    out property <length> fs-caption: 10px;
    out property <length> fs-meta: 11px;
    out property <length> fs-small: 12px;
    out property <length> fs-body: 13px;
    out property <int> fw-title: 600;
    out property <length> row-plain: 86px;
    out property <length> body-folder: 36px;
    out property <length> body-papers: 40px;
    out property <length> row-head: 23px;
    out property <length> cell: 184px;
    out property <length> width: 480px;
    out property <length> height: 620px;
    out property <length> drag-start: 6px;
    out property <duration> double-click: 500ms;
    out property <length> double-reach: 10px;
    out property <duration> appear: 120ms;
    out property <duration> settle: 150ms;
    out property <duration> let-go: 90ms;
    out property <length> stir: 3px;
}

export global Hue {
    out property <color> text: Theme.light ? #4F46E5 : #A5B4FC;
    out property <color> image: Theme.light ? #1E7A45 : #84D3A2;
    out property <color> file: Theme.light ? #6A6B75 : #A1A3AC;
    out property <color> link: Theme.light ? #1D5FC8 : #8DBAF2;
    pure public function of(kind: string) -> color {
        return kind == "image" ? self.image
            : kind == "file" || kind == "folder" || kind == "audio" || kind == "video" ? self.file
            : kind == "link" ? self.link
            : self.text;
    }
}
